{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/protect_files.py" }
        ]
      }
    ],
    "PostToolUse": [
      
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/run_tests.py" }
        ]
      }
    ]
  }
}
